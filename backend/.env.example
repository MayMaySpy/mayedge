# testnet | mainnet (default: testnet)
LIGHTER_NETWORK=testnet

# Required for trading / account streams (indexes 0-3 are reserved)
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=4
LIGHTER_API_PRIVATE_KEY=

# Optional: default market symbol
DEFAULT_MARKET_SYMBOL=LIT

# Server bind (local dev defaults to 127.0.0.1:8000; Docker sets 0.0.0.0 inside the container)
# BIND_HOST=127.0.0.1
# BIND_PORT=8000

# Reject orders above this quote notional (USD); 0 to disable
MAX_ORDER_NOTIONAL=50000

# Extra host names the desk answers to, as a JSON list. Loopback and *.ts.net are built in.
# ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]","*.ts.net","desk.example.internal"]
